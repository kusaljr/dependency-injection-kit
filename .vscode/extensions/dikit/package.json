{
  "name": "dikit-syntax",
  "displayName": "Dikit Schema Syntax",
  "description": "Syntax highlighting and LSP support for .dikit schema files",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.97.0"
  },
  "activationEvents": [
    "onLanguage:dikit"
  ],
  "main": "./extension.js",
  "categories": [
    "Programming Languages",
    "Language Servers"
  ],
  "contributes": {
    "languages": [
      {
        "id": "dikit",
        "aliases": [
          "Dikit",
          "dikit"
        ],
        "extensions": [
          ".dikit"
        ],
        "configuration": "./language.configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dikit",
        "scopeName": "source.dikit",
        "path": "./syntaxes/dikit.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
